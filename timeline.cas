/* ============================================
   VISAPULSE — TIMELINES PAGE
============================================ */

.page-header {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 32px 24px;
}
.page-header-inner {
  max-width: 1160px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}
.page-title {
  font-size: 28px;
  font-weight: 300;
  letter-spacing: -0.03em;
  color: var(--ink);
}
.page-sub { font-size: 14px; color: var(--ink-4); margin-top: 4px; }

.header-stats {
  display: flex;
  align-items: center;
  gap: 0;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.hstat-sm {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10px 20px;
}
.hstat-sm .mono-num {
  font-size: 20px;
  font-weight: 500;
  color: var(--ink);
  font-family: var(--mono);
  line-height: 1.2;
}
.hstat-sm span:last-child { font-size: 11px; color: var(--ink-4); }
.hstat-sm-div { width: 1px; height: 28px; background: var(--border); }

/* ---- LAYOUT ---- */
.tl-page {
  display: grid;
  grid-template-columns: 220px 1fr;
  max-width: 1160px;
  margin: 28px auto;
  gap: 24px;
  padding: 0 24px;
  align-items: start;
}
@media (max-width: 780px) {
  .tl-page { grid-template-columns: 1fr; }
  .tl-sidebar { display: none; }
}

/* ---- SIDEBAR ---- */
.tl-sidebar { position: sticky; top: 80px; }
.sidebar-section { margin-bottom: 24px; }
.sidebar-label {
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--ink-4);
  margin-bottom: 8px;
}
.sidebar-options { display: flex; flex-direction: column; gap: 3px; }
.sfilter {
  text-align: left;
  background: transparent;
  border: none;
  padding: 7px 10px;
  font-size: 13px;
  color: var(--ink-3);
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all 0.12s;
}
.sfilter:hover { background: var(--surface-3); color: var(--ink); }
.sfilter-on { background: var(--green-light); color: var(--green-dark); font-weight: 500; }

.sidebar-cta {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 14px;
  background: var(--ink);
  border-radius: var(--radius-md);
  margin-top: 8px;
  cursor: pointer;
  transition: background 0.15s;
}
.sidebar-cta:hover { background: var(--ink-2); }
.sidebar-cta strong { font-size: 13px; font-weight: 500; color: #fff; }
.sidebar-cta span { font-size: 11px; color: rgba(255,255,255,0.5); }

/* ---- COMPARE BANNER ---- */
.compare-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background: var(--purple-light);
  border: 1px solid rgba(91,79,207,0.2);
  border-radius: var(--radius-lg);
  margin-bottom: 16px;
  flex-wrap: wrap;
  gap: 12px;
}
.cb-title { font-size: 15px; font-weight: 500; color: var(--purple); }
.cb-sub { font-size: 12px; color: rgba(91,79,207,0.6); margin-top: 2px; }
.cb-stats { display: flex; gap: 24px; }
.cb-stat { text-align: center; }
.cb-num {
  font-size: 22px;
  font-weight: 500;
  color: var(--purple);
  font-family: var(--mono);
  line-height: 1.2;
}
.cb-lbl { font-size: 11px; color: rgba(91,79,207,0.6); }

/* ---- SORT ROW ---- */
.sort-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}
.sort-label { font-size: 12px; color: var(--ink-4); }
.sort-select {
  font-size: 13px;
  padding: 5px 10px;
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--ink);
  cursor: pointer;
}
.result-count { margin-left: auto; font-size: 12px; color: var(--ink-4); font-family: var(--mono); }

/* ---- FULL TIMELINE CARDS ---- */
.tl-full-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 18px 20px;
  margin-bottom: 12px;
  transition: border-color 0.15s, box-shadow 0.15s;
  animation: fadeInUp 0.3s ease both;
}
.tl-full-card:hover {
  border-color: var(--border-strong);
  box-shadow: var(--shadow-sm);
}
.tl-full-card.hidden { display: none; }

.tl-full-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 14px;
}
.tl-full-meta { display: flex; flex-direction: column; gap: 3px; }
.tl-full-type { font-size: 15px; font-weight: 500; color: var(--ink); }
.tl-full-origin { font-size: 12px; color: var(--ink-4); font-family: var(--mono); }
.tl-full-right { display: flex; align-items: center; gap: 10px; }
.tl-full-days {
  font-size: 18px;
  font-weight: 500;
  color: var(--purple);
  font-family: var(--mono);
}

/* ---- OUTCOME BADGE ---- */
.outcome-badge {
  font-size: 11px;
  font-weight: 500;
  padding: 3px 10px;
  border-radius: 20px;
  font-family: var(--mono);
}
.outcome-approved { background: var(--green-light); color: var(--green-dark); }
.outcome-pending { background: var(--amber-light); color: var(--amber); }
.outcome-refused { background: var(--red-light); color: var(--red); }

/* ---- MILESTONES ---- */
.tl-milestones {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
  overflow-x: auto;
  padding-bottom: 4px;
}
.milestone {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}
.ms-dot {
  width: 10px; height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}
.dot-applied { background: var(--ink-4); }
.dot-bio { background: var(--purple); }
.dot-decision { background: var(--amber); }
.dot-done { background: var(--green); }
.dot-pending {
  width: 10px; height: 10px;
  border-radius: 50%;
  border: 2px solid var(--amber);
  background: transparent;
}
.ms-info { display: flex; flex-direction: column; gap: 1px; }
.ms-label { font-size: 11px; font-weight: 500; color: var(--ink); }
.ms-date { font-size: 10px; color: var(--ink-4); font-family: var(--mono); }
.ms-line {
  height: 1.5px;
  width: 32px;
  background: var(--border-strong);
  flex-shrink: 0;
  margin: 0 4px;
}
.ms-dashed {
  background: repeating-linear-gradient(90deg, var(--border-strong) 0, var(--border-strong) 4px, transparent 4px, transparent 8px);
}
.ms-short { width: 48px; }

/* ---- NOTES ---- */
.tl-full-note {
  font-size: 12px;
  color: var(--ink-3);
  margin-top: 10px;
  padding: 8px 12px;
  background: var(--surface-2);
  border-radius: var(--radius-sm);
  border-left: 3px solid var(--border-strong);
  line-height: 1.5;
}
.empty-note { border-left-color: var(--ink-5); color: var(--ink-5); }

/* ---- EMPTY STATE ---- */
.empty-state {
  text-align: center;
  padding: 48px 24px;
}
.empty-icon { font-size: 40px; margin-bottom: 12px; }
.empty-title { font-size: 17px; font-weight: 500; color: var(--ink); }
.empty-sub { font-size: 14px; color: var(--ink-4); margin-top: 6px; }
.empty-samples { margin-top: 32px; text-align: left; }
.empty-sample-label { font-size: 12px; color: var(--ink-4); margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.05em; }
.sample-card { opacity: 0.6; pointer-events: none; }

/* ---- SUBMIT BANNER (reuse from base) ---- */
.submit-banner {
  background: var(--ink);
  padding: 40px 24px;
  margin-top: 8px;
}
.submit-banner-inner {
  max-width: 700px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}
.submit-banner-text h3 {
  font-size: 22px;
  font-weight: 400;
  color: #fff;
  letter-spacing: -0.02em;
}
.submit-banner-text p {
  font-size: 14px;
  color: rgba(255,255,255,0.5);
  margin-top: 4px;
}